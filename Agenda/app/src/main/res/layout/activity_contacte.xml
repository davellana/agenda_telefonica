<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D3EBF2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dades del contacte"
            android:textAlignment="center"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_margin="20dp"/>

        <EditText
            android:id="@+id/txtNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/txtNCognoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cognoms"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/txtAdreca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adreça"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/txtNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telèfon"
            android:inputType="phone"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correu electrònic"
            android:inputType="textEmailAddress"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <EditText
            android:id="@+id/txtData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data de naixement"
            android:inputType="date"
            android:background="#FFFFFF"
            android:padding="10dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="15dp"
            android:background="#205050"/>

        <Button
            android:id="@+id/btn_eliminar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Eliminar contacte"
            android:backgroundTint="#953636"/>

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Cancel·lar"
            android:backgroundTint="#953636"/>

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:backgroundTint="#346825"/>

    </LinearLayout>

</ScrollView>
