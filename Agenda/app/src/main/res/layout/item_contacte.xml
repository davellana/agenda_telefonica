<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/borde_redondo"
        android:padding="2dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_no_user"
            android:scaleType="centerCrop"
            android:background="@drawable/borde_redondo"
            android:clipToOutline="true"/>

    </FrameLayout>

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:text="Nom Cognoms"
        android:textSize="16sp"/>

    <ImageButton
        android:id="@+id/btn_editar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/outline_border_color_24"
        android:background="@drawable/borde_redondo"
        android:scaleType="centerInside"
        android:contentDescription="Editar contacte"
        app:tint="#444444"/>

    <ImageButton
        android:id="@+id/btn_llamar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_call_24"
        android:background="@drawable/borde_redondo"
        android:scaleType="centerInside"
        android:layout_marginLeft="5dp"
        android:contentDescription="Trucar al contacte"
        app:tint="#444444"/>

    <ImageButton
        android:id="@+id/btn_email"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_mail_24"
        android:background="@drawable/borde_redondo"
        android:scaleType="centerInside"
        android:layout_marginLeft="5dp"
        android:contentDescription="Enviar correu"
        app:tint="#444444"/>

</LinearLayout>
