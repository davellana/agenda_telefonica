<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#D3EBF2"
    tools:context=".MainActivity">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edició de contacte"
        android:textAlignment="center"
        android:textSize="34dp"
        android:textStyle="bold"
        android:layout_margin="20dp"
        />

    <EditText
        android:id="@+id/txtNom"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:background="#ffffff"
        android:textSize="20dp"
        android:hint="Nom"
        android:padding="5dp"
        />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_height="3dp"
        android:background="#205050"
        />
    <EditText
        android:id="@+id/txtNCognoms"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:background="#ffffff"
        android:textSize="20dp"
        android:hint="Cognoms"
        android:padding="5dp"
        />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_marginBottom="10dp"
        android:layout_height="3dp"
        android:background="#205050"
        />
    <EditText
        android:id="@+id/txtNum"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:background="#ffffff"
        android:textSize="20dp"
        android:hint="Telèfon"
        android:inputType="number"
        android:padding="5dp"

        />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#205050"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        />
    <Button
        android:id="@+id/btn_eliminar"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Eliminar"
        android:backgroundTint="#953636"
        />
        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Cancel·lar"
            android:backgroundTint="#953636"
            />
        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:backgroundTint="#346825"
            />


    </LinearLayout>

